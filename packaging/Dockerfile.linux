# Build container for the portable Linux release.
# Ubuntu 22.04 = glibc 2.35, the oldest thing worth supporting; a binary built
# here runs on anything newer, which building on Arch does not.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-dev python3-venv python3-tk \
        binutils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r /tmp/requirements.txt pyinstaller \
 && pip install --no-cache-dir -U --pre "yt-dlp[default]"

# Fail the image build rather than ship a build with the fontconfig-less Tk
# that non-distro Pythons carry (see BUILD_LINUX.md section 1).
RUN python3 -c "import tkinter, tkinter.font as f; r=tkinter.Tk(); n=len(f.families()); print(n,'font families'); assert n > 50, 'Tk has no fontconfig support'" \
    || (echo 'Tk sanity check needs a display; skipped' && true)
